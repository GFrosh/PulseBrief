# ---------------------------------------------------------------------------
# PulseBrief — Firebase AI Logic configuration
# Copy this file to `.env` and fill in the values from your Firebase console.
# Every value here is safe to ship to the browser (Firebase web config is public);
# real authorization happens through App Check + Firebase Security Rules.
# ---------------------------------------------------------------------------

# Firebase web app config (Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA Enterprise site key (Project settings -> App Check)
VITE_RECAPTCHA_SITE_KEY=

# App Check debug token — ONLY for local development.
# Generate one in Firebase console -> App Check -> Apps -> Manage debug tokens,
# or pass any UUID and register it there. Never commit the real value.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: a second Firebase project used ONLY for AI calls (for example a
# project that has credit). The app tries it first and switches to the main
# project above, then to the backup engine, if it fails. Hosting, sign-in and
# the database always stay on the main project. Leave these empty to skip it.
# The App Check site key here must come from the second project.
VITE_AI_PRIMARY_API_KEY=
VITE_AI_PRIMARY_AUTH_DOMAIN=
VITE_AI_PRIMARY_PROJECT_ID=
VITE_AI_PRIMARY_APP_ID=
VITE_AI_PRIMARY_RECAPTCHA_SITE_KEY=

# Force the bundled deterministic demo engine even when Firebase is configured.
# Handy for offline demos / judge laptops without network.
# VITE_DEMO_ENGINE=true

# Optional: how long (milliseconds) to wait for the on-device model before the
# backup engine answers instead. Raise these on a slow laptop to watch Gemini
# Nano finish its answers; keep the defaults for demos.
# VITE_AI_LOCAL_LIVE_TIMEOUT_MS=8000
# VITE_AI_LOCAL_GATE_TIMEOUT_MS=6000
