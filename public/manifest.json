{
  "manifest_version": 3,
  "name": "PulseBrief — Hybrid AI Call Co-Pilot",
  "version": "1.0.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["sidePanel", "tabCapture", "activeTab"],
  "side_panel": { "default_path": "index.html" },
  "action": {
    "default_title": "Open PulseBrief Co-Pilot",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" }
}
